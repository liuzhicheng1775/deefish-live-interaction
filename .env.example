# ===== DeepSeek API =====
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 抖音开放平台（官方模式） =====
# 直播小玩法 / 互动插件 凭证
DOUYIN_CLIENT_KEY=your-client-key
DOUYIN_CLIENT_SECRET=your-client-secret
DOUYIN_APP_ID=your-live-mini-app-id
# Webhook 回调验签 Token
DOUYIN_WEBHOOK_VERIFY_TOKEN=your-verify-token

# ===== 逆向 WebSocket 模式（可选，增强弹幕接入） =====
# 参考 DouyinLiveJava 的签名服务
DOUYIN_SIGN_API_URL=http://localhost:8001/sign
DOUYIN_COOKIE=
# 目标直播间 web_rid（live.douyin.com/xxx 里的 xxx）
DOUYIN_LIVE_WEB_RID=

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8765
LOG_LEVEL=INFO

# ===== 限流 / 风控 =====
# 同一用户 N 秒内最多回复几条
RATE_LIMIT_PER_USER_SEC=10
# 全局每分钟最多回复条数
RATE_LIMIT_GLOBAL_PER_MIN=60
# AI 回复温度
AI_TEMPERATURE=0.8
# AI 最大回复长度（抖音弹幕最多约 30 字，互动插件卡片可放宽）
AI_MAX_REPLY_CHARS=60
